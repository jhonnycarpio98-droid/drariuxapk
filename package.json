{
  "name": "civitas-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Civitas — app Android (Capacitor + React) que consume la API JSON del motor Evennia.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs && capacitor-assets generate --android",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "sharp": "^0.35.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
